<div
  id="aviso-cookies"
  class="fixed bottom-4 right-4 left-4 z-50 mx-auto max-w-3xl hidden border border-linea bg-papel px-5 py-4 shadow-[0_24px_50px_-30px_rgba(43,37,33,0.75)] sm:px-6"
  role="dialog"
  aria-live="polite"
  aria-label="Aviso de cookies"
>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
    <p class="flex-1 text-menudo leading-relaxed text-cuerpo">
      <strong class="font-medium text-tinta">Usamos tecnologías técnicas</strong>
      para el funcionamiento del sitio. Si aceptas, también permitiremos
      servicios de terceros (por ejemplo Google Maps y Google Analytics) que
      pueden establecer cookies. Puedes ver más en <a
        href="/politica-de-cookies/"
        class="rounded-sm text-rosa-profundo underline underline-offset-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa"
        >la política de cookies</a
      >.
    </p>

    <div class="flex shrink-0 items-center gap-2">
      <button
        id="cookies-rechazar"
        class="cursor-pointer px-3 py-2 text-menudo font-medium text-atenuado underline underline-offset-4 transition-colors hover:text-tinta focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa"
        >Rechazar</button
      >
      <button
        id="cookies-aceptar"
        class="cursor-pointer bg-tinta px-4 py-2 text-menudo font-medium text-papel transition-colors hover:bg-rosa-profundo focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa focus-visible:ring-offset-2 focus-visible:ring-offset-papel"
        >Aceptar cookies</button
      >
    </div>
  </div>
</div>
