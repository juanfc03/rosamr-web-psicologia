---
import { Image } from 'astro:assets';
import logo from '@/assets/logo.webp';
import Menu from '@/components/icons/Menu.astro';
import Chevron from '@/components/icons/Chevron.astro';
import { navegacion, redes } from '@/data/navegacion';

const rutaActual = Astro.url.pathname + Astro.url.hash;

function esActivo(item: (typeof navegacion)[number]): boolean {
  if ('href' in item) {
    return rutaActual === item.href;
  }
  const rutaBase = item.hijas[0].href.split('#')[0];
  if (rutaActual === rutaBase) return true;
  return item.hijas.some(hija => rutaActual === hija.href);
}

const claseBaseNavegacion =
  'enlace-nav inline-flex items-center py-2 text-menu font-medium text-atenuado transition-colors hover:text-tinta focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa focus-visible:ring-offset-2 focus-visible:ring-offset-papel';
const claseActiva = 'text-tinta';
const claseInactiva = 'text-atenuado';
---

<header
  class="sticky top-0 z-20 w-full border-b border-linea bg-papel/85 backdrop-blur-md"
>
  <div class="mx-auto 2xl:max-w-screen-2xl px-4 sm:px-6 md:px-8">
    <div class="flex items-center justify-between gap-4 py-4 md:py-5">
      <a
        href="/"
        class="inline-flex items-center gap-3 rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa focus-visible:ring-offset-2 focus-visible:ring-offset-papel"
        aria-label="Rosa María Ruiz Cano, ir a inicio"
      >
        <Image
          src={logo}
          alt="Logo de Rosa María Ruiz Cano"
          class="h-9 sm:h-10 md:h-11 w-auto"
          widths={[64, 80, 96, 112]}
          sizes="(min-width:768px) 112px, (min-width:640px) 96px, 64px"
          decoding="async"
          loading="eager"
        />
        <span class="hidden sm:flex flex-col gap-1.5 leading-none" aria-hidden="true">
          <span class="font-display text-marca leading-none text-tinta">
            Rosa María Ruiz Cano
          </span>
          <span class="text-etiqueta text-sutil">Psicóloga General Sanitaria</span>
        </span>
      </a>

      <!-- Navegación escritorio -->
      <nav
        class="hidden xl:flex items-center gap-6 2xl:gap-9"
        aria-label="Navegación principal"
      >
        {
          navegacion.map(item =>
            'href' in item ? (
              <a
                href={item.href}
                aria-current={esActivo(item) ? 'page' : undefined}
                data-activo={esActivo(item) ? '' : undefined}
                class:list={[
                  claseBaseNavegacion,
                  esActivo(item) ? claseActiva : claseInactiva,
                ]}
              >
                {item.etiqueta}
              </a>
            ) : (
              <details class="relative" name="navegacion-principal">
                <summary
                  data-activo={esActivo(item) ? '' : undefined}
                  class:list={[
                    claseBaseNavegacion,
                    'group cursor-pointer list-none gap-1 rounded-sm',
                    esActivo(item) ? claseActiva : claseInactiva,
                  ]}
                >
                  {item.etiqueta}
                  <Chevron class="size-4 text-rosa transition-transform duration-200 ease-out group-open:rotate-180" />
                </summary>
                <div
                  class="desplegable invisible absolute start-0 top-full z-10 min-w-52 border border-linea bg-papel py-2 shadow-[0_20px_40px_-28px_rgba(43,37,33,0.6)]"
                >
                  <ul role="list">
                    {item.hijas.map(hija => (
                      <li>
                        <a
                          href={hija.href}
                          aria-current={
                            rutaActual === hija.href ? 'location' : undefined
                          }
                          class="block px-4 py-2.5 text-menu text-cuerpo transition-colors hover:bg-papel-2 hover:text-rosa-profundo focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa focus-visible:ring-inset"
                        >
                          {hija.etiqueta}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            ),
          )
        }
      </nav>

      <div class="flex items-center gap-1 sm:gap-2">
        {
          Object.values(redes).map(({ href, descripcion, Icono }) => (
            <a
              href={href}
              target="_blank"
              rel="me noopener noreferrer"
              aria-label={`${descripcion} (se abre en una pestaña nueva)`}
              class="group inline-flex items-center justify-center rounded-sm p-2 text-atenuado transition-colors hover:text-rosa-profundo focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa focus-visible:ring-offset-2 focus-visible:ring-offset-papel"
            >
              <Icono class="size-[1.4rem] md:size-6" />
            </a>
          ))
        }

        <button
          type="button"
          id="abrir-menu-movil"
          aria-label="Abrir menú de navegación"
          aria-controls="menu-movil"
          aria-expanded="false"
          class="inline-flex cursor-pointer items-center justify-center rounded-sm p-2 text-tinta transition-colors hover:text-rosa-profundo focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa focus-visible:ring-offset-2 focus-visible:ring-offset-papel xl:hidden"
        >
          <Menu class="size-7" />
        </button>
      </div>
    </div>
  </div>

  <nav
    id="menu-movil"
    aria-label="Navegación principal móvil"
    class="hidden absolute inset-x-0 top-full max-h-[calc(100dvh-5rem)] overflow-y-auto border-b border-linea bg-papel shadow-[0_28px_50px_-30px_rgba(43,37,33,0.65)]"
    inert
  >
    <div class="mx-auto 2xl:max-w-screen-2xl px-4 py-4 sm:px-6 md:px-8">
      <ul class="space-y-1" role="list">
        {
          navegacion.map(item =>
            'href' in item ? (
              <li>
                <a
                  href={item.href}
                  aria-current={esActivo(item) ? 'page' : undefined}
                  data-activo={esActivo(item) ? '' : undefined}
                  class:list={[
                    'enlace-nav block py-2.5 text-subtitulo font-display leading-tight transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa focus-visible:ring-offset-2 focus-visible:ring-offset-papel',
                    esActivo(item) ? claseActiva : claseInactiva,
                  ]}
                >
                  {item.etiqueta}
                </a>
              </li>
            ) : (
              <li>
                <details class="desplegable-movil-detalle">
                  <summary
                    data-activo={esActivo(item) ? '' : undefined}
                    class:list={[
                      'enlace-nav group flex cursor-pointer list-none items-center justify-between py-2.5 font-display text-subtitulo leading-tight transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa focus-visible:ring-offset-2 focus-visible:ring-offset-papel',
                      esActivo(item) ? claseActiva : claseInactiva,
                    ]}
                  >
                    {item.etiqueta}
                    <Chevron class="size-4 text-rosa transition-transform duration-200 ease-out group-open:rotate-180" />
                  </summary>
                  <div
                    class="desplegable invisible ms-1 border-s border-linea ps-4"
                  >
                    <ul class="py-1.5">
                      {item.hijas.map(hija => (
                        <li>
                          <a
                            href={hija.href}
                            aria-current={
                              rutaActual === hija.href ? 'location' : undefined
                            }
                            class="block py-2.5 text-menu text-cuerpo transition-colors hover:text-rosa-profundo focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa focus-visible:ring-inset"
                          >
                            {hija.etiqueta}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </details>
              </li>
            ),
          )
        }
      </ul>
    </div>
  </nav>
</header>

<script src="../scripts/header.ts"></script>

<style>
  @reference '@/styles/global.css';

  .enlace-nav {
    position: relative;
  }

  .enlace-nav::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -0.15rem;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.28s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .enlace-nav:hover::after,
  .enlace-nav:focus-visible::after {
    transform: scaleX(1);
  }

  .enlace-nav[data-activo]::after {
    background-color: var(--color-rosa);
    transform: scaleX(1);
  }
</style>
