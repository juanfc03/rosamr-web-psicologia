---
import { Image } from 'astro:assets';
import { legal, redes } from '@/data/pie';
import stampMundopsicologos from '@/assets/mundopsicologos-stamp.png';

const claseEnlace =
  'rounded-sm text-cuerpo underline decoration-linea decoration-1 underline-offset-4 transition-colors hover:text-rosa-profundo hover:decoration-rosa focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa';
---

<footer
  class="mt-16 border-t border-linea bg-papel-2 text-cuerpo sm:mt-20 lg:mt-28"
>
  <div
    class="mx-auto 2xl:max-w-screen-2xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8 lg:py-20"
  >
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <section aria-label="Contacto" class="space-y-4 lg:col-span-4">
        <h2 class="font-display text-subtitulo leading-none text-tinta">
          Rosa María Ruiz Cano
        </h2>
        <p class="text-etiqueta text-rosa-profundo">Psicóloga General Sanitaria</p>
        <p class="medida-estrecha text-menudo leading-relaxed text-atenuado">
          Acompañamiento psicológico profesional y humano. Sesiones online y
          presenciales bajo confidencialidad.
        </p>

        <address class="not-italic text-menudo">
          <span class="block font-medium text-tinta">Contacto:</span>
          <span class="block text-atenuado">Granada, España</span>
          <ul class="mt-3 space-y-2.5">
            <li>
              <a
                href="tel:+34674307408"
                aria-label="Llamar por teléfono a Rosa María Ruiz"
                class={claseEnlace}
              >
                Llamar por teléfono
              </a>
            </li>
            <li>
              <a
                href="mailto:rosamruizpsicologa@gmail.com"
                aria-label="Enviar correo a rosamruizpsicologa@gmail.com"
                class={claseEnlace}
              >
                rosamruizpsicologa@gmail.com
              </a>
            </li>
            <li>
              <a
                href="https://wa.me/34674307408?text=¡Hola Rosa!"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Hablar por WhatsApp (se abre en una pestaña nueva)"
                class={claseEnlace}
              >
                Hablar por WhatsApp
              </a>
            </li>
            <li>
              <a
                href="/pedir-cita/"
                aria-label="Formulario de contacto para pedir cita"
                class={claseEnlace}
              >
                Formulario de contacto
              </a>
            </li>
          </ul>
        </address>
      </section>

      <nav
        aria-label="Páginas legales"
        class="space-y-4 lg:col-span-2 lg:col-start-6"
      >
        <h2 class="text-etiqueta text-sutil">Páginas legales</h2>
        <ul class="space-y-2.5 text-menudo">
          {
            legal.map(item => (
              <li>
                <a
                  href={item.href}
                  aria-current={
                    Astro.url.pathname === item.href ? 'page' : undefined
                  }
                  class={claseEnlace}
                >
                  {item.etiqueta}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section
        aria-label="Información legal"
        class="space-y-4 text-menudo lg:col-span-3"
      >
        <h2 class="text-etiqueta text-sutil">Información legal</h2>
        <dl class="space-y-1.5">
          <dt class="text-atenuado">N.º de colegiada:</dt>
          <dd class="font-display text-apoyo text-tinta">AO-13788</dd>
          <dt class="pt-2 text-atenuado">Colegio Oficial de Psicología:</dt>
          <dd class="font-display text-apoyo text-tinta">
            Andalucía Oriental
          </dd>
        </dl>

        <a
          href="https://www.mundopsicologos.com/centros/rosa-maria-ruiz-cano?utm_source=450075&utm_medium=widget&utm_campaign=widget-company_stamp"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa"
          aria-label="Perfil de Rosa María Ruiz Cano en MundoPsicólogos (se abre en una pestaña nueva)"
        >
          <Image
            src={stampMundopsicologos}
            alt="Rosa María Ruiz Cano en MundoPsicólogos"
            class="h-auto w-full max-w-44"
            loading="lazy"
            decoding="async"
          />
        </a>

        <p class="text-menudo leading-relaxed text-sutil">
          La información que compartas será tratada con absoluta
          confidencialidad y conforme a la normativa vigente en materia de
          protección de datos.
        </p>
      </section>

      <section aria-label="Redes" class="space-y-4 text-menudo lg:col-span-2">
        <h2 class="text-etiqueta text-sutil">Redes</h2>
        <ul class="space-y-2.5">
          {
            redes.map(red => (
              <li>
                <a
                  href={red.href}
                  target="_blank"
                  rel="me noopener noreferrer"
                  aria-label={`${red.etiqueta} (se abre en una pestaña nueva)`}
                  class={claseEnlace}
                >
                  {red.etiqueta}
                </a>
              </li>
            ))
          }
        </ul>

        <p class="text-menudo leading-relaxed text-sutil">
          No ofrezco atención psicológica de urgencia por redes sociales. En
          caso de riesgo inmediato para tu seguridad o la de otra persona,
          contacta con emergencias de tu país.
        </p>
      </section>
    </div>
  </div>

  <div class="border-t border-linea bg-tinta text-papel/70">
    <div
      class="mx-auto flex max-w-screen-2xl flex-col items-center justify-between gap-3 px-4 py-5 text-center text-menudo sm:flex-row sm:px-6 sm:text-left lg:px-8"
    >
      <p>
        &copy; <span id="anio-pie">{new Date().getFullYear()}</span> Rosa María
        Ruiz Cano · Todos los derechos reservados
      </p>

      <p>
        Hecho con cariño por <a
          href="https://www.linkedin.com/in/juan-fernández-ceacero"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn de Juan Fernández Ceacero (se abre en una pestaña nueva)"
          class="rounded-sm text-papel underline decoration-papel/40 underline-offset-4 transition-colors hover:decoration-papel focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa"
        >
          Juan
        </a>
      </p>
    </div>
  </div>
</footer>

<script src="../scripts/footer-actualizar-fecha.ts"></script>
