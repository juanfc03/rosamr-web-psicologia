---
import { Image } from 'astro:assets';
import imgTca from '@/assets/ilustracion-trastornos-conducta-alimentaria.png';
import Pill from '@/components/utils/Pill.astro';
import { bloquesServicios, problemasRelacionComida } from '@/data/servicios';

const claseMarcador = 'mt-2.5 h-px w-4 shrink-0 bg-rosa';
const scrollAnclas =
  'scroll-mt-28 sm:scroll-mt-32 md:scroll-mt-36 lg:scroll-mt-40';
---

<section
  id="servicios"
  class="mx-auto 2xl:max-w-screen-2xl px-4 pt-10 sm:px-6 sm:pt-14 md:px-8 lg:pt-20"
  aria-labelledby="titulo-servicios"
>
  <header class="revelar grid gap-8 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <Pill>Servicios psicológicos</Pill>
      <h1
        id="titulo-servicios"
        class="mt-5 font-display text-titulo font-normal text-tinta text-balance"
      >
        Servicios de <em class="not-italic text-rosa-profundo"
          >psicología en Granada</em
        > adaptados a tu historia
      </h1>
    </div>
    <p class="lg:col-span-5 medida text-parrafo text-atenuado">
      Trabajo con personas que atraviesan dificultades relacionadas con la
      comida, la imagen corporal, la ansiedad, el estrés y otros momentos
      complejos de la vida. Aquí puedes ver algunas de las áreas en las que más
      suelo acompañar.
    </p>
  </header>

  <!-- TCA -->
  <article
    class="mt-14 grid gap-10 border-t border-linea pt-10 lg:grid-cols-12 lg:gap-14 lg:pt-14"
  >
    <div class="revelar space-y-5 lg:col-span-7">
      <h2
        id="tca"
        class={`font-display text-subtitulo text-tinta text-balance ${scrollAnclas}`}
      >
        Trastornos de conducta alimentaria (TCA)
      </h2>

      <p class="medida text-parrafo text-cuerpo">
        Trabajo con personas que viven una relación difícil con la comida y el
        cuerpo. El objetivo es comprender la función de lo que ocurre y
        construir una forma más segura y amable de relacionarte contigo.
      </p>

      <ul class="medida space-y-2 text-parrafo text-cuerpo">
        <li class="flex gap-3">
          <span class={claseMarcador} aria-hidden="true"></span>
          <span
            >Acompañamiento en anorexia, bulimia, trastorno por atracón,
            ortorexia o vigorexia.</span
          >
        </li>
        <li class="flex gap-3">
          <span class={claseMarcador} aria-hidden="true"></span>
          <span
            >Trabajo con la imagen corporal, la culpa, el control y la
            autoexigencia relacionada con la comida.</span
          >
        </li>
      </ul>

      <h3 class="pt-4 font-display text-apoyo text-tinta">
        Dificultades frecuentes en la relación con la comida
      </h3>

      <p class="medida text-parrafo text-cuerpo">
        La relación con la comida y con el cuerpo suele estar cargada de
        historias y aprendizajes personales. En esta área trabajamos no solo los
        síntomas, sino la función de cada conducta y la construcción de
        alternativas más seguras.
      </p>

      <div class="grid gap-x-10 gap-y-6 sm:grid-cols-2">
        {
          problemasRelacionComida.map(item => (
            <article class="revelar border-t border-linea pt-4">
              <h4 class="font-display text-apoyo text-tinta">{item.titulo}</h4>
              <p class="mt-2 text-menudo leading-relaxed text-atenuado">
                {item.texto}
              </p>
            </article>
          ))
        }
      </div>

      <p class="medida text-menudo leading-relaxed text-sutil">
        Cada proceso es único. Si te ves reflejada/o en alguna de estas
        descripciones o tienes dudas sobre si tu caso encaja aquí, podemos
        valorarlo juntos en una primera consulta.
      </p>
    </div>

    <figure class="revelar m-0 space-y-3 lg:col-span-5 lg:self-start">
      <div class="overflow-hidden rounded-sm border border-linea bg-rosa-tenue">
        <Image
          src={imgTca}
          alt="Ilustración de una persona en un entorno tranquilo, representando la especialización en TCA y la relación con la comida y el cuerpo"
          width={1845}
          height={1536}
          quality={78}
          widths={[480, 640, 800, 960]}
          sizes="(min-width:1024px) 40vw, 100vw"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="h-auto w-full object-cover"
        />
      </div>
      <figcaption class="text-menudo leading-relaxed text-atenuado">
        Especialización en TCA y en los problemas derivados de la relación con
        la comida y el cuerpo.
      </figcaption>
    </figure>
  </article>

  <!-- Otros servicios -->
  <div class="mt-14 grid gap-x-12 gap-y-12 sm:grid-cols-2 lg:mt-16">
    {
      bloquesServicios.map(bloque => (
        <article class="revelar space-y-4 border-t border-linea pt-6">
          <h2
            id={bloque.id}
            class={`font-display text-subtitulo text-tinta text-balance ${scrollAnclas}`}
          >
            {bloque.titulo}
          </h2>

          <p class="text-parrafo text-cuerpo">{bloque.descripcion}</p>

          <ul class="space-y-2 text-parrafo text-atenuado">
            {bloque.bullets.map(item => (
              <li class="flex gap-3">
                <span class={claseMarcador} aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <div class="revelar mt-14 border-t border-linea pt-8">
    <a
      href="/pedir-cita/"
      class="inline-flex items-center justify-center rounded-sm bg-tinta px-6 py-3.5 text-etiqueta text-papel transition-colors hover:bg-rosa-profundo focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa focus-visible:ring-offset-2 focus-visible:ring-offset-papel"
    >
      Pedir una cita
    </a>
  </div>
</section>
