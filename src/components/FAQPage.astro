---
import Chevron from '@/components/icons/Chevron.astro';

import { preguntas } from '@/data/faq';
---

<section
  aria-labelledby="preguntas-titulo"
  class="mx-auto 2xl:max-w-screen-2xl px-4 pt-10 sm:px-6 sm:pt-14 md:px-8 lg:pt-20"
>
  <header class="revelar grid gap-8 lg:grid-cols-12 lg:items-end">
    <h1
      id="preguntas-titulo"
      class="lg:col-span-7 font-display text-titulo font-normal text-tinta text-balance"
    >
      Preguntas frecuentes sobre la terapia y cómo <em
        class="not-italic text-rosa-profundo">pedir cita</em
      >
    </h1>

    <p class="lg:col-span-5 medida text-parrafo text-atenuado">
      Resolvemos dudas sobre cómo pedir cita, sesiones presenciales en Granada y
      por videollamada, duración (60 min), precios orientativos, privacidad y
      tratamientos para TCA, ansiedad y estrés. Si tienes alguna otra consulta
      no dudes en contactarme.
    </p>
  </header>

  <ul class="mt-12 border-t border-linea">
    {
      preguntas.map(({ pregunta, respuesta }, idx) => (
        <li class="revelar">
          <details class="group border-b border-linea" open={idx === 0}>
            <summary
              class="flex cursor-pointer list-none items-start justify-between gap-6 rounded-sm py-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa focus-visible:ring-offset-2 focus-visible:ring-offset-papel"
              aria-expanded={idx === 0 ? 'true' : 'false'}
              aria-controls={`faq-respuesta-${idx}`}
            >
              <span class="font-display text-apoyo text-tinta text-balance">
                {pregunta}
              </span>
              <Chevron class="mt-1 size-5 shrink-0 text-rosa transition-transform duration-300 ease-out group-open:rotate-180" />
            </summary>

            <div
              id={`faq-respuesta-${idx}`}
              class="respuesta overflow-hidden pb-7 text-parrafo text-cuerpo"
              set:html={respuesta}
            />
          </details>
        </li>
      ))
    }
  </ul>
</section>

<script src="../scripts/faq-acordeon.ts"></script>

<style>
  .respuesta :global(p) {
    max-width: 68ch;
  }

  .respuesta :global(p + p) {
    margin-top: 0.75rem;
  }
</style>
