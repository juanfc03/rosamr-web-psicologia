<div class="revelar border-t border-linea pt-8 md:pt-10">
  <header class="space-y-4">
    <h2 class="font-display text-titulo font-normal text-tinta">
      Pide tu cita <em class="not-italic text-rosa-profundo">ahora</em>
    </h2>

    <p class="medida text-parrafo text-atenuado">
      Rellena este formulario para solicitar una cita o enviarme tu consulta. Te
      contactaré para coordinar día y hora. Recuerda que también puedes
      contactarme por <a
        href="https://wa.me/34674307408?text=¡Hola Rosa!"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contactar por WhatsApp (se abre en una nueva pestaña)"
        class="rounded-sm text-rosa-profundo underline decoration-rosa/40 decoration-1 underline-offset-4 transition-colors hover:decoration-rosa-profundo focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa"
        >WhatsApp</a
      > o <a
        href="mailto:rosamruizpsicologa@gmail.com"
        class="rounded-sm text-rosa-profundo underline decoration-rosa/40 decoration-1 underline-offset-4 transition-colors hover:decoration-rosa-profundo focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa"
        >Email</a
      >.
    </p>
  </header>

  <form
    name="contacto"
    method="POST"
    class="mt-10 grid gap-7"
    data-netlify="true"
    netlify-honeypot="bot-field"
  >
    <div class="hidden" aria-hidden="true">
      <label
        >No rellenes este campo: <input
          type="text"
          name="bot-field"
          autocomplete="off"
        /></label
      >
    </div>

    <div>
      <label class="etiqueta-formulario"
        >Nombre
        <input
          type="text"
          name="nombre"
          required
          minlength="2"
          maxlength="50"
          title="Introduce tu nombre y apellidos"
          autocomplete="name"
          class="entrada-formulario"
          placeholder="Tu nombre y apellidos"
        />
      </label>
    </div>

    <div>
      <label class="etiqueta-formulario"
        >Email
        <input
          type="email"
          name="email"
          required
          maxlength="100"
          title="Introduce un correo electrónico válido"
          autocomplete="email"
          inputmode="email"
          class="entrada-formulario"
          placeholder="tucorreo@ejemplo.com"
        />
      </label>
    </div>

    <div>
      <label class="etiqueta-formulario"
        >Número de teléfono
        <input
          type="tel"
          name="telefono"
          required
          minlength="9"
          maxlength="15"
          pattern="[+]?[0-9]{9,14}"
          autocomplete="tel"
          inputmode="tel"
          title="Introduce un número de teléfono válido (ej. 612345678 o +34612345678)"
          class="entrada-formulario"
          placeholder="+34 6XX XXX XXX"
        />
      </label>
    </div>

    <div>
      <label class="etiqueta-formulario"
        >Mensaje
        <textarea
          name="mensaje"
          rows="4"
          title="Introduce el mensaje"
          required
          minlength="10"
          maxlength="600"
          class="entrada-formulario resize-y"
          placeholder="Cuéntame brevemente en qué puedo ayudarte"></textarea>
      </label>
    </div>

    <div class="flex items-start gap-3">
      <input
        type="checkbox"
        id="acepto_privacidad"
        name="acepto_privacidad"
        required
        class="mt-1 size-5 shrink-0 cursor-pointer rounded-sm border border-linea accent-rosa-profundo focus-visible:ring-2 focus-visible:ring-rosa"
      />
      <label for="acepto_privacidad" class="text-parrafo text-atenuado">
        He leído y acepto la <a
          href="/politica-de-privacidad/"
          class="rounded-sm text-rosa-profundo underline decoration-rosa/40 decoration-1 underline-offset-4 transition-colors hover:decoration-rosa-profundo focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa"
          >política de privacidad</a
        >.
      </label>
    </div>

    <button
      type="submit"
      class="w-full cursor-pointer rounded-sm bg-tinta px-6 py-4 text-center text-etiqueta text-papel transition-colors hover:bg-rosa-profundo focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa focus-visible:ring-offset-2 focus-visible:ring-offset-papel"
    >
      Enviar solicitud
    </button>
  </form>

  <slot />
</div>

<div
  id="form-toast"
  class="pointer-events-none fixed bottom-6 right-6 z-50 max-w-sm translate-x-full rounded-sm px-5 py-4 text-parrafo text-white opacity-0 shadow-[0_20px_45px_-24px_rgba(43,37,33,0.8)] transition-[opacity,translate] duration-500 ease-out"
  role="status"
  aria-live="polite"
>
</div>

<script src="../../scripts/formulario-contacto.ts"></script>

<style>
  @reference '@/styles/global.css';

  .entrada-formulario {
    @apply mt-2 block w-full border-b border-linea bg-transparent px-0 py-2 text-parrafo text-tinta placeholder:text-sutil focus-visible:border-rosa-profundo focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosa focus-visible:ring-offset-2 focus-visible:ring-offset-papel;
  }

  .etiqueta-formulario {
    @apply block text-etiqueta text-atenuado;
  }

  .toast-exito {
    background-color: var(--color-salvia-profundo);
  }

  .toast-error {
    background-color: var(--color-rosa-profundo);
  }

  #form-toast.mostrar {
    opacity: 1;
    translate: 0;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    #form-toast {
      transition: none;
    }
  }
</style>
