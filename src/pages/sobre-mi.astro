---
import Layout from '@/layouts/Layout.astro';
import About from '@/components/About.astro';
import imgFoto from '@/assets/rosa-maria-ruiz-cano-psicologa-granada-sentada.jpeg';

const titulo = 'Rosa María Ruiz Cano · Sobre mí: psicóloga sanitaria en Granada';
const descripcion =
  'Conoce mi formación, enfoque y trayectoria como psicóloga general sanitaria especializada en TCA, ansiedad, estrés y violencia de género en Granada y online.';
const canonica = `${Astro.site}sobre-mi/`;
const imagenOG = `${Astro.site}open-graph/sobre-mi.png`;
const altImagenOG = 'Rosa María Ruiz Cano, psicóloga general sanitaria en Granada';

const urlFoto = new URL(imgFoto.src, Astro.site).href;

const esquema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Rosa María Ruiz Cano, Psicóloga General Sanitaria',
  jobTitle: 'Psicóloga General Sanitaria',
  url: `${Astro.site}sobre-mi/`,
  image: [
    imagenOG,
    {
      '@type': 'ImageObject',
      contentUrl: urlFoto,
      url: urlFoto,
      caption: 'Rosa María Ruiz Cano, psicóloga general sanitaria en Granada',
      representativeOfPage: true,
    },
  ],
  sameAs: [
    'https://www.instagram.com/con.agallas/',
    'https://www.linkedin.com/in/rosa-maría-ruiz-cano/',
  ],
  worksFor: {
    '@type': 'MedicalBusiness',
    name: 'Rosa María Ruiz Cano, Psicóloga General Sanitaria',
    '@id': `${Astro.site}#localbusiness`,
    image: imagenOG,
    telephone: '+34674307408',
    priceRange: '$$',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'C. Nécora, 7, Chana',
      addressLocality: 'Granada',
      postalCode: '18003',
      addressCountry: 'ES',
    },
  },
};
---

<Layout
  titulo={titulo}
  descripcion={descripcion}
  canonica={canonica}
  imagenOG={imagenOG}
  altImagenOG={altImagenOG}
  esquema={esquema}
>
  <About />
</Layout>
