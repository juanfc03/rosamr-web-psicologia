---
import Layout from '@/layouts/Layout.astro';
import FAQPage from '@/components/FAQPage.astro';
import { preguntas } from '@/data/faq';

const titulo = 'Rosa María Ruiz Cano · Preguntas frecuentes sobre la terapia psicológica';
const descripcion =
  'Resuelve tus dudas sobre el precio de las sesiones, la terapia online, la duración del proceso y cómo empezar terapia con Rosa María Ruiz, psicóloga en Granada.';
const canonica = `${Astro.site}preguntas-frecuentes/`;
const imagenOG = `${Astro.site}open-graph/preguntas-frecuentes.png`;
const altImagenOG = 'Preguntas frecuentes sobre la terapia de Rosa María Ruiz Cano';

const esquema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map(item => ({
    '@type': 'Question',
    name: item.pregunta,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.respuesta
        .replace(/<[^>]*>?/gm, '')
        .replace(/\s+/g, ' ')
        .trim(),
    },
  })),
};
---

<Layout
  titulo={titulo}
  descripcion={descripcion}
  canonica={canonica}
  imagenOG={imagenOG}
  altImagenOG={altImagenOG}
  esquema={esquema}
>
  <FAQPage />
</Layout>
